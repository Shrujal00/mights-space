# Copy to .env and fill in. Every key is optional — a missing key makes that
# provider report "unavailable" rather than breaking the analysis.

# VirusTotal — https://www.virustotal.com/gui/my-apikey
# Public tier: 4 requests/min, 500/day. We send HASHES ONLY, never the file.
VT_API_KEY=

# abuse.ch — one key covers BOTH MalwareBazaar and ThreatFox.
# Free from https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# urlscan.io — https://urlscan.io/user/profile/
# Used for SEARCH ONLY. We never submit URLs (submission makes them public).
URLSCAN_API_KEY=

# Set true for air-gapped operation: skips all network enrichment and still
# produces a complete local report (hashes, YARA, PE, IOCs, ATT&CK).
OFFLINE_MODE=false

DATABASE_URL=postgresql+psycopg2://malware:malware@db:5432/malware_analysis
SAMPLE_STORAGE_DIR=/app/storage/samples

# Ollama — drafts the plain-language narrative in the Word report.
# API key from https://ollama.com/settings/keys
# Optional: without it the Word report is still produced, using the narrative
# the analysers generate themselves.
OLLAMA_API_KEY=

# Hosted API (no local install). For a local Ollama daemon instead, use
# OLLAMA_HOST=http://localhost:11434 and keep the -cloud suffix on the model.
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# Printed at the head of every exported report.
REPORT_AUTHORITY=SURAT CYBER POLICE INDIA

# --- Dynamic analysis (running the sample, not just reading it) --------------
# Off by default. Turning this on means uploaded samples are EXECUTED in a
# sandbox. An Android detonation boots an emulator: several minutes and a few
# gigabytes of RAM per sample, and runs are deliberately serialised, so do not
# enable it on a host that also runs a Windows VM.
DYNAMIC_ANALYSIS_ENABLED=false

# Android. The AVD must be built from a google_apis system image, NOT
# google_apis_playstore: a playstore image has a locked /system, `adb root`
# fails on it, and frida-server cannot be started.
#   sdkmanager "system-images;android-33;google_apis;x86_64"
#   avdmanager create avd -n triage -k "system-images;android-33;google_apis;x86_64"
ANDROID_SDK_ROOT=
# Only needed when avdmanager wrote the AVD somewhere other than ~/.android/avd
# (it follows XDG_CONFIG_HOME when that is set). Check `avdmanager list avd`.
ANDROID_AVD_HOME=
ANDROID_AVD=triage

# frida-server for android-x86_64, matching the installed frida version exactly
# (`python -c "import frida; print(frida.__version__)"`). Download from
# https://github.com/frida/frida/releases
FRIDA_SERVER_PATH=

# How long the app is left running under instrumentation after its screens have
# been exercised, and how long to wait for the emulator to finish booting.
DETONATION_DWELL_SECONDS=45
DETONATION_BOOT_TIMEOUT_SECONDS=300

# How long after data is read a transmission can still plausibly be carrying it.
# Widening this finds more pairings and weaker ones.
EXFILTRATION_WINDOW_MS=5000
